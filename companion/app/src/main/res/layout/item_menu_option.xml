<?xml version="1.0" encoding="utf-8"?>
<!--
  Watch-optimised menu row.
  • 64dp min-height — comfortable touch target on small screens
  • Tonal icon container instead of bare icon
  • Leading icon  + title + optional subtitle + optional badge + chevron
  • All colours via theme attributes — adapts to dark/light automatically
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingVertical="12dp"
    android:minHeight="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Tonal icon container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:strokeWidth="0dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            app:tint="?attr/colorPrimary"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Title + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:justificationMode="inter_word">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="1dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Badge / extra info -->
    <TextView
        android:id="@+id/tvExtraInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="?attr/colorPrimary"
        android:background="@drawable/badge_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"/>

    <!-- Chevron -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="?android:attr/textColorSecondary"
        android:alpha="0.5"/>

</LinearLayout>
