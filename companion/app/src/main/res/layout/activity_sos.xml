<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="?attr/colorErrorContainer">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SOS"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:letterSpacing="0.2"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_sos_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="@style/TextAppearance.Material3.DisplayLarge"
        android:textStyle="bold"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:trackColor="@android:color/transparent"
        app:indicatorColor="?attr/colorOnErrorContainer"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"/>

    <TextView
        android:id="@+id/tv_sos_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sos_calling"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:alpha="0.8"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/sos_cancel"
        app:backgroundTint="?android:attr/colorBackground"
        android:textColor="?attr/colorError"
        android:textStyle="bold"/>

</LinearLayout>
