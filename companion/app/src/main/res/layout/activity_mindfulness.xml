<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/tv_breathing_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mindfulness_measuring_hrv"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Circular progress ring -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_breathing"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="8dp"
        app:indicatorSize="130dp"
        app:trackThickness="10dp"
        app:trackCornerRadius="5dp"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"/>

    <TextView
        android:id="@+id/tv_breathing_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="?android:attr/textColorPrimary"
        android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- HRV badge -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/tv_hrv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HRV -- ms"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mindfulness_stop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/mindfulness_stop"
        style="@style/Widget.Material3.Button.OutlinedButton"/>

</LinearLayout>
