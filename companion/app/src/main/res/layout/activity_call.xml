<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?android:attr/colorBackground"
    android:padding="24dp">

    <!-- Caller avatar / icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp"
        android:layout_marginBottom="20dp">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_call_answer"
            app:tint="?attr/colorOnPrimaryContainer"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Caller name -->
    <TextView
        android:id="@+id/tv_caller_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_unknown"
        android:textColor="?android:attr/textColorPrimary"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- Caller number -->
    <TextView
        android:id="@+id/tv_caller_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000 000 000"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:layout_marginTop="4dp"
        android:gravity="center"/>

    <!-- Call status badge -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="?attr/colorTertiaryContainer"
        app:strokeWidth="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="40dp">
        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_incoming"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reject + Answer FABs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Reject -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/colorErrorContainer"
            app:srcCompat="@drawable/ic_call_end"
            app:fabCustomSize="64dp"
            app:maxImageSize="28dp"
            app:tint="?attr/colorOnErrorContainer"
            app:borderWidth="0dp"
            app:shapeAppearanceOverlay="@style/Shape.Circle"
            android:contentDescription="@string/call_reject"/>

        <Space android:layout_width="48dp" android:layout_height="wrap_content"/>

        <!-- Answer -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/colorTertiaryContainer"
            app:srcCompat="@drawable/ic_call_answer"
            app:fabCustomSize="64dp"
            app:maxImageSize="28dp"
            app:tint="?attr/colorOnTertiaryContainer"
            app:borderWidth="0dp"
            app:shapeAppearanceOverlay="@style/Shape.Circle"
            android:contentDescription="@string/call_answer"/>

    </LinearLayout>

</LinearLayout>
