<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════════
         RTOSify Watch App — Material 3 Theme
         Optimised for small watch screens: denser type, high-contrast surfaces.
         Default light (when watch uses day mode). Dark override in values-night/.
         ═══════════════════════════════════════════════════════════════════════ -->

    <style name="Theme.Smartwatch" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">#3DAADC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D0EEFA</item>
        <item name="colorOnPrimaryContainer">#003549</item>

        <!-- Secondary — alerts, heart rate -->
        <item name="colorSecondary">#DC3D3D</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFDAD6</item>
        <item name="colorOnSecondaryContainer">#410002</item>

        <!-- Tertiary — fitness positive, activity rings -->
        <item name="colorTertiary">#22CC88</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#B8F5DA</item>
        <item name="colorOnTertiaryContainer">#002116</item>

        <!-- Surfaces — watch UIs tend to prefer slightly darker surfaces -->
        <item name="colorSurface">#F5F8FC</item>
        <item name="colorOnSurface">#181C20</item>
        <item name="colorSurfaceVariant">#DCE4EC</item>
        <item name="colorOnSurfaceVariant">#40484F</item>
        <item name="colorSurfaceContainer">#E8EEF5</item>
        <item name="colorSurfaceContainerHigh">#E2E8EF</item>
        <item name="colorSurfaceContainerHighest">#DCE3EA</item>

        <!-- Outline -->
        <item name="colorOutline">#70787F</item>
        <item name="colorOutlineVariant">#C0C8CF</item>

        <!-- Error -->
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>

        <!-- System bars — transparent edge-to-edge -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Shape — more rounded for watch touch targets -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Large</item>
    </style>

    <!-- ── Shapes ─────────────────────────────────────────────────────────── -->
    <style name="Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Shape.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ── Dialer button ──────────────────────────────────────────────────── -->
    <style name="DialerButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:layout_margin">1dp</item>
    </style>

    <!-- ── Day toggle button ─────────────────────────────────────────────── -->
    <style name="DayToggleButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">@color/day_button_selector</item>
        <item name="android:textColor">@color/day_button_text_selector</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Circle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ── Translucent overlay ───────────────────────────────────────────── -->
    <style name="Theme.Smartwatch.Translucent" parent="Theme.Smartwatch">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
