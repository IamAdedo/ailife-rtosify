<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Semantic primitives (not for direct use in layouts — use theme attrs) ── -->

    <!-- Brand palette -->
    <color name="brand_blue">#3DAADC</color>
    <color name="brand_blue_dark">#00506A</color>
    <color name="brand_green">#22CC88</color>
    <color name="brand_red">#DC3D3D</color>

    <!-- Absolute values — only where theme attrs cannot be used -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- Upload progress -->
    <color name="upload_amber">#FBC600</color>

    <!-- App Widget — RemoteViews requires @color/ references -->
    <!-- Light widget theme (phone home-screen widgets default to light) -->
    <color name="widget_background">#FFF5F8FC</color>
    <color name="widget_background_media">#F0EDF1F7</color>
    <color name="widget_text_primary">#FF181C20</color>
    <color name="widget_text_secondary">#FF40484F</color>
    <color name="widget_divider">#1F181C20</color>
    <color name="widget_button_background">#FFE2E8EF</color>

    <!-- Dynamic Island overlay — needs alpha transparency in code -->
    <color name="island_background">#E6000000</color>

    <!-- File manager accent (used in code, not XML) -->
    <color name="colorAccent">#3DAADC</color>

</resources>
